+// Turing port (local_llms Paper 8, W7): whether a kernel's largest dynamic shared memory request plus its static
+// shared memory fits the device's opt-in limit. The row caps behind that request assume an 80 KB budget, but the
+// request depends on the instance (K, M, residual): plain int8 at m == 1 and low K asks for about 49 KB, which a
+// 64 KB part holds. Checked once per kernel and device, before cudaFuncSetAttribute, so a request that does not
+// fit is declined (fall through to the next path) rather than failing the attribute call. The kernels' own
+// constants, and so their work decomposition, are unchanged.
+static std::map<void*, bool> gemv_fit_cache[MAX_DEVICES];
+
+static bool gemv_int8_smem_fits(void* fn, size_t dyn_request, int device)
+{
+    auto it = gemv_fit_cache[device].find(fn);
+    if (it != gemv_fit_cache[device].end()) return it->second;
+    cudaFuncAttributes attr;
+    bool fits = cudaFuncGetAttributes(&attr, fn) == cudaSuccess &&
+                dyn_request + attr.sharedSizeBytes <= (size_t) DevCtx::instance().get_smem_max(device);
+    cudaGetLastError();
+    gemv_fit_cache[device][fn] = fits;
+    return fits;
+}
