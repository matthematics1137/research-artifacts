+    float scale_log2, int causal, int block_rows, int h_blocks, int kv_append_len
+)
+{
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ < 750)
+    __trap();
+#else
+    __shared__ float sm_o[3 * FD_SLOT_STRIDE];
+    __shared__ float sm_m[FD_WARPS][8];
+    __shared__ float sm_l[FD_WARPS][8];
+
+    const int split = blockIdx.y;
+    if (split >= num_splits) return;            // launched at the split cap; extra splits store nothing
+    const int pid = blockIdx.x;
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int g = lane >> 2, c = lane & 3;
+
+    const int group = n_q_heads / n_kv_heads;
+    const int h_block = pid % h_blocks;
+    const int bh = pid / h_blocks;
+    const int b = bh / n_kv_heads;
+    const int kvh = bh - b * n_kv_heads;
+    const int rows_here = min(block_rows, q_len * group - h_block * block_rows);
+    const int n_rt = (rows_here + 7) >> 3;
+    const int streams = FD_WARPS / n_rt;
+    const int rt = warp % n_rt;
+    const int stream = warp / n_rt;
+    const bool active = stream < streams;
+
+    const int total_k = cache_seqlens[b] + kv_append_len;
+    const int n_start = split * split_len;
+    const int n_end = min(n_start + split_len, total_k);
+
+    // Q^T B fragments: query row g of this row tile, rotated dims 64c..64c+63, two dims per k-step
+    uint32_t qf[32];
+    {
+        const int r_blk = rt * 8 + g;
+        const int row_idx = h_block * block_rows + r_blk;
+        float x[64];
+        if (active && r_blk < rows_here)
+        {
+            const int row_q = row_idx % q_len, hl = row_idx / q_len;
+            const uint4* qp = reinterpret_cast<const uint4*>(
+                q + ((int64_t) (b * q_len + row_q) * n_q_heads + kvh * group + hl) * FD_HD + 64 * c);
+            #pragma unroll
+            for (int i = 0; i < 8; ++i)
+            {
+                uint4 v = qp[i];
+                const half2* h = reinterpret_cast<const half2*>(&v);
+                #pragma unroll
+                for (int k = 0; k < 4; ++k)
+                {
+                    float2 f = __half22float2(h[k]);
+                    x[8 * i + 2 * k] = f.x;
+                    x[8 * i + 2 * k + 1] = f.y;
+                }
+            }
+        }
+        else
+        {
+            #pragma unroll
+            for (int i = 0; i < 64; ++i) x[i] = 0.0f;
+        }
+        fwht32(x);
+        fwht32(x + 32);
+        const float hs = 0.1767578125f;     // fp16(1 / sqrt(32)), the entry of the Triton h32 matrix
+        #pragma unroll
+        for (int kk = 0; kk < 32; ++kk) qf[kk] = h2u(__floats2half2_rn(x[2 * kk] * hs, x[2 * kk + 1] * hs));
