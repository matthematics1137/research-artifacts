+            l[e] = l[e] * alpha + p[e] + p[2 + e];
+            m2[e] = mn;
+            #pragma unroll
+            for (int mt = 0; mt < 16; ++mt)
+            {
+                o[mt][e] *= alpha;
+                o[mt][2 + e] *= alpha;
+            }
+        }
+
+        // P^T B fragments (k = key, n = query row), one per 8-key step
+        const uint32_t bp0 = movtrans(h2u(__floats2half2_rn(p[0], p[1])));
+        const uint32_t bp1 = movtrans(h2u(__floats2half2_rn(p[2], p[3])));
+
+        // O^T += V^T P^T: 16 m-tiles of 16 dims x 2 k-steps of 8 keys
+        #pragma unroll
+        for (int j = 0; j < 2; ++j)
+        {
+            const uint32_t* va = reinterpret_cast<const uint32_t*>(vw[2 * j]);
+            const uint32_t* vb = reinterpret_cast<const uint32_t*>(vw[2 * j + 1]);
+            const half2 v128 = __halves2half2(__hmul(vs[2 * j], __float2half(1.0f / 128.0f)),
+                                              __hmul(vs[2 * j + 1], __float2half(1.0f / 128.0f)));
+            const half2 v256 = __halves2half2(__hmul(vs[2 * j], __float2half(1.0f / 256.0f)),
+                                              __hmul(vs[2 * j + 1], __float2half(1.0f / 256.0f)));
+            const uint32_t bp = j ? bp1 : bp0;
+            #pragma unroll
+            for (int mt = 0; mt < 16; ++mt)
+            {
+                const uint32_t tt = __byte_perm(va[mt >> 1], vb[mt >> 1], (mt & 1) ? 0x7362 : 0x5140);
+                const uint32_t a0 = deq2(__byte_perm(tt, 0x64646464, 0x4140), v128, v256);
+                const uint32_t a1 = deq2(__byte_perm(tt, 0x64646464, 0x4342), v128, v256);
+                mma1688(o[mt], a0, a1, bp);
+            }
+        }
+    }
+
+    // Row totals: each lane summed its own keys
+    #pragma unroll
+    for (int e = 0; e < 2; ++e)
+    {
+        l[e] += __shfl_xor_sync(0xffffffff, l[e], 4);
+        l[e] += __shfl_xor_sync(0xffffffff, l[e], 8);
+        l[e] += __shfl_xor_sync(0xffffffff, l[e], 16);
+    }
+
+    // Streams 1.. hand (m, l, O) to the row tile's stream-0 warp
+    if (active)
+    {
+        if (g == 0)
+        {
+            sm_m[warp][2 * c] = m2[0]; sm_m[warp][2 * c + 1] = m2[1];
+            sm_l[warp][2 * c] = l[0]; sm_l[warp][2 * c + 1] = l[1];
+        }
+        if (stream > 0)
+        {
+            float* slot = sm_o + (warp - n_rt) * FD_SLOT_STRIDE;
+            #pragma unroll
+            for (int e = 0; e < 2; ++e)
+            {
+                float* sr = slot + (2 * c + e) * FD_ROW_STRIDE + g;    // + dim / 32 padding (= g)
+                #pragma unroll
+                for (int mt = 0; mt < 16; ++mt)
+                {
+                    sr[32 * g + 2 * mt] = o[mt][e];
+                    sr[32 * g + 2 * mt + 1] = o[mt][2 + e];
+                }
+            }
+        }
+    }
+    __syncthreads();
+
+    if (active && stream == 0)
+    {
+        const int64_t slot_base = (int64_t) (pid * num_splits + split) * block_rows;
+        #pragma unroll
+        for (int e = 0; e < 2; ++e)
+        {
+            const int row = 2 * c + e;
+            float mmax = m2[e];
+            for (int st = 1; st < streams; ++st) mmax = fmaxf(mmax, sm_m[rt + st * n_rt][row]);
+            const float mu = mmax == -INFINITY ? 0.0f : mmax;
+            const float w0 = m2[e] == -INFINITY ? 0.0f : exp2f(m2[e] - mu);
+            float lt = l[e] * w0;
+            #pragma unroll
+            for (int mt = 0; mt < 16; ++mt)
+            {
+                o[mt][e] *= w0;
+                o[mt][2 + e] *= w0;
+            }
+            for (int st = 1; st < streams; ++st)
+            {
+                const int ws = rt + st * n_rt;
+                const float ms = sm_m[ws][row];
+                const float wsc = ms == -INFINITY ? 0.0f : exp2f(ms - mu);
+                lt += sm_l[ws][row] * wsc;
+                const float* sr = sm_o + (ws - n_rt) * FD_SLOT_STRIDE + row * FD_ROW_STRIDE + g;
+                #pragma unroll
+                for (int mt = 0; mt < 16; ++mt)
+                {
+                    o[mt][e] += wsc * sr[32 * g + 2 * mt];
+                    o[mt][2 + e] += wsc * sr[32 * g + 2 * mt + 1];
+                }
+            }
+            const int r_blk = rt * 8 + row;
+            float* po = partial_o + (slot_base + r_blk) * FD_HD + 32 * g;
+            #pragma unroll
+            for (int mt = 0; mt < 16; ++mt)
+                *reinterpret_cast<float2*>(po + 2 * mt) = make_float2(o[mt][e], o[mt][2 + e]);
+            if (g == 0)
+            {
+                float* pm = partial_ml + (slot_base + r_blk) * 2;
+                pm[0] = mmax == -INFINITY ? -INFINITY : mmax * 0.6931471805599453f;   // natural-log max
+                pm[1] = lt;
+            }
+        }
+    }
+#endif
+}
+
+void* fd75d_split_fn() { return (void*) fd75d_split_kernel; }
+
+void fd75d_row_layout(int q_len, int group_size, int* block_rows, int* h_blocks)
+{
+    int rows = q_len * group_size;
+    int p2 = 1;
+    while (p2 < rows) p2 <<= 1;
+    *block_rows = p2 < 16 ? 16 : (p2 > 32 ? 32 : p2);
+    *h_blocks = (rows + *block_rows - 1) / *block_rows;
+}
+
+cudaError_t fd75d_split_launch
+(
+    const half* q, const uint32_t* qk, const uint32_t* qv, const int* block_table, const int* cache_seqlens,
+    float* partial_o, float* partial_ml, const half* sk, const half* sv,
+    int split_len, int num_pages_per_seq, int num_splits,
+    int bsz, int q_len, int n_q_heads, int n_kv_heads, int page_size, float scale, bool causal,
+    int kv_append_len, int splits_cap, cudaStream_t stream
+)
+{
+    int block_rows, h_blocks;
+    fd75d_row_layout(q_len, n_q_heads / n_kv_heads, &block_rows, &h_blocks);
+    int programs = bsz * n_kv_heads * h_blocks;
+    float scale_log2 = scale * 1.4426950408889634f;
+    int causal_i = causal ? 1 : 0;
+    void* args[] =
+    {
+        (void*) &q, (void*) &qk, (void*) &qv, (void*) &block_table, (void*) &cache_seqlens,
+        (void*) &partial_o, (void*) &partial_ml, (void*) &sk, (void*) &sv,
+        (void*) &split_len, (void*) &num_pages_per_seq, (void*) &num_splits,
+        (void*) &q_len, (void*) &n_q_heads, (void*) &n_kv_heads, (void*) &page_size,
+        (void*) &scale_log2, (void*) &causal_i, (void*) &block_rows, (void*) &h_blocks, (void*) &kv_append_len
+    };
+    return cudaLaunchKernel((void*) fd75d_split_kernel, dim3(programs, splits_cap), dim3(FD_THREADS), args, 0, stream);
+}
+
+#ifdef FD75D_STANDALONE
+// Test entry (tools/turing/fd75d_test.py builds this file alone as a torch extension)
+#include <torch/extension.h>
+#include <ATen/cuda/CUDAContext.h>
+
+void fd75d_split_py(at::Tensor q, at::Tensor qk, at::Tensor qv, at::Tensor sk, at::Tensor sv, at::Tensor block_table,
+                    at::Tensor cache_seqlens, at::Tensor partial_o, at::Tensor partial_ml, int64_t split_len,
+                    int64_t num_splits, int64_t splits_cap, int64_t kv_append_len, double scale, bool causal,
+                    int64_t n_kv_heads)
+{
+    TORCH_CHECK(q.dtype() == at::kHalf && q.is_contiguous() && q.dim() == 4 && q.size(3) == FD_HD, "q (bsz, q_len, hq, 256) fp16");
+    TORCH_CHECK(qk.dtype() == at::kInt && qv.dtype() == at::kInt && qk.is_contiguous() && qv.is_contiguous(), "packed caches");
+    TORCH_CHECK(qk.size(2) == n_kv_heads * 64, "8-bit packed cache: n_kv_heads * 64 words per token");
+    TORCH_CHECK(sk.dtype() == at::kHalf && sv.dtype() == at::kHalf && sk.size(2) == n_kv_heads * 8, "scales");
+    TORCH_CHECK(qk.size(1) % FD_KT == 0, "page size a multiple of 16");
+    cudaError_t err = fd75d_split_launch(
+        (const half*) q.data_ptr(), (const uint32_t*) qk.data_ptr(), (const uint32_t*) qv.data_ptr(),
+        block_table.data_ptr<int>(), cache_seqlens.data_ptr<int>(),
+        partial_o.data_ptr<float>(), partial_ml.data_ptr<float>(),
+        (const half*) sk.data_ptr(), (const half*) sv.data_ptr(),
+        (int) split_len, (int) block_table.size(1), (int) num_splits,
+        (int) q.size(0), (int) q.size(1), (int) q.size(2), (int) n_kv_heads, (int) qk.size(1), (float) scale, causal,
+        (int) kv_append_len, (int) splits_cap, at::cuda::getCurrentCUDAStream());
+    TORCH_CHECK(err == cudaSuccess, "fd75d launch: ", cudaGetErrorString(err));
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m)
+{
+    m.def("split", &fd75d_split_py, "fd75d phase 1 (test entry)");
+}
+#endif
