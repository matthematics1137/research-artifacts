+// Turing port (local_llms Paper 8, W10b): the tallest slice (multiple of 8 rows) whose shared layout fits the
+// device's opt-in limit next to the instance's static shared memory. gemv_int8_sq_rows_max() sizes slices for an
+// 80 KB budget, so at m >= 2 every instance asks for 80 KB or more, and on a 64 KB part W7's fit check declined
+// them all: no multi-row launch ever took this path on Turing, upstream's m == 2 included. The kernel lays out
+// its shared memory from the rows_per it is given, so when the host chooses the slice height (W9) a lower cap
+// keeps host and kernel in step. fixed_bytes is the layout's height-independent part, per_row its per-row part.
+static std::map<void*, int> gemv_sq_rows_cap_cache[MAX_DEVICES];
+
+static int gemv_int8_sq_rows_cap(void* fn, int rows_max, size_t fixed_bytes, int per_row, int device)
+{
+    auto it = gemv_sq_rows_cap_cache[device].find(fn);
+    if (it != gemv_sq_rows_cap_cache[device].end()) return it->second;
+    cudaFuncAttributes attr;
+    int64_t room = -1;
+    if (cudaFuncGetAttributes(&attr, fn) == cudaSuccess)
+        room = (int64_t) DevCtx::instance().get_smem_max(device) - (int64_t) attr.sharedSizeBytes - (int64_t) fixed_bytes;
+    cudaGetLastError();
+    int cap = room > 0 ? MIN(rows_max, (int) (room / per_row) & ~7) : 0;
+    gemv_sq_rows_cap_cache[device][fn] = cap;
+    return cap;
+}
